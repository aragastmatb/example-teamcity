# ============================================================================
# TeamCity Build Agent Configuration
# Генерируется Ansible из шаблона
# ============================================================================

# 🔑 КРИТИЧЕСКИ: URL TeamCity Server для подключения
# Эта переменная передаётся через Ansible из Terraform outputs
serverURL={{ server_url }}

# Имя агента в интерфейсе TeamCity
name={{ agent_name | default(inventory_hostname) }}

# Порт для связи с сервером (по умолчанию 9090)
ownPort=9090

# Авторизационный токен (генерируется сервером при первой авторизации)
# authorizationToken=

# Директории агента
workDir=/opt/buildagent/work
tempDir=/opt/buildagent/temp
systemDir=/opt/buildagent/system

# Логирование
logLimit=10485760

# Дополнительные параметры
env.JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64