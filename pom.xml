<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <modelVersion>4.0.0</modelVersion>
    
    <!-- ==================== КООРДИНАТЫ ПРОЕКТА ==================== -->
    <groupId>com.example</groupId>
    <artifactId>example-teamcity</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    
    <name>Example TeamCity Project</name>
    <description>Учебный проект для настройки CI/CD в TeamCity</description>
    
    <!-- ==================== СВОЙСТВА ==================== -->
    <properties>
        <!-- Кодировка исходных файлов -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        
        <!-- Версия Java для компиляции -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        
        <!-- Версии зависимостей (централизованное управление) -->
        <junit.version>4.13.2</junit.version>
    </properties>
    
    <!-- ==================== ЗАВИСИМОСТИ ==================== -->
    <dependencies>
        <!-- JUnit 4 для модульных тестов -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>  <!-- Только для компиляции и запуска тестов -->
        </dependency>
    </dependencies>
    
    <!-- ==================== СБОРКА ==================== -->
    <build>
        <plugins>
            <!-- Плагин компиляции Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            
            <!-- Плагин для запуска тестов -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <!-- Выводить детали упавших тестов в лог -->
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
            
            <!-- Плагин для создания executable JAR (опционально) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- Главный класс для запуска через java -jar -->
                            <mainClass>com.example.Welcomer</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
    <!-- ==================== РАСПРЕДЕЛЕНИЕ АРТЕФАКТОВ (NEXUS) ==================== -->
    <!-- 
         Эти настройки говорят Maven, КУДА загружать артефакты при выполнении `mvn deploy`.
         ID 'nexus' должен совпадать с ID в settings.xml для аутентификации.
    -->
    <distributionManagement>
        <!-- Репозиторий для RELEASE-версий (стабильные версии без -SNAPSHOT) -->
        <repository>
            <id>nexus</id>
            <name>Nexus Releases Repository</name>
            <!-- Замените <nexus_ip> на реальный адрес вашего Nexus -->
            <url>http://${env.NEXUS_URL}:8081/repository/maven-releases/</url>
        </repository>
        
        <!-- Репозиторий для SNAPSHOT-версий (разработческие версии) -->
        <snapshotRepository>
            <id>nexus</id>
            <name>Nexus Snapshots Repository</name>
<<<<<<< HEAD
