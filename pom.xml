=======
            <url>http://${env.NEXUS_URL}:8081/repository/maven-snapshots/</url>
>>>>>>> dba699d85fede91ef8f937449482246f4da84e41
        </snapshotRepository>
    </distributionManagement>
    
    <!-- ==================== РЕПОЗИТОРИИ ДЛЯ ЗАГРУЗКИ ЗАВИСИМОСТЕЙ ==================== -->
    <repositories>
        <repository>
            <id>nexus-public</id>
            <name>Nexus Public Group</name>
            <url>http://${env.NEXUS_URL}:8081/repository/maven-public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
    
</project>